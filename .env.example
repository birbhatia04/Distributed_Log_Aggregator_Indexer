POSTGRES_USER=logweave
POSTGRES_PASSWORD=logweave_local
POSTGRES_DB=logweave
DATABASE_URL=postgresql://logweave:logweave_local@postgres:5432/logweave
DATABASE_SHARD_URLS=postgresql://logweave:logweave_local@postgres:5432/logweave,postgresql://logweave:logweave_local@postgres-shard-1:5432/logweave
REDIS_URL=redis://redis:6379/0
AGENT_API_KEY=logweave-local-agent
AGENT_SESSION_ID=00000000000000000000000000000001
CORS_ORIGINS=http://localhost:5173
MAX_GENERATION_RATE=500
MAX_TOTAL_GENERATION_RATE=500
GENERATOR_IDLE_SECONDS=120
MAX_ACTIVE_SESSIONS=50
MAX_SESSION_QUEUE=10000
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false
RETENTION_DAYS=7
TAIL_SERVICE=tailed-application
TAIL_BATCH_SIZE=200
TAIL_POLL_SECONDS=0.5
